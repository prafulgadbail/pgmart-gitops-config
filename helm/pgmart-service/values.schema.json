{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "pgmart-service values",
  "type": "object",
  "required": ["image", "secret", "ingress"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "containerPort": { "type": "integer" },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "secret": {
      "type": "object",
      "required": ["remoteKey"],
      "properties": {
        "remoteKey": { "type": "string", "minLength": 1 },
        "storeName": { "type": "string" }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 2 },
        "maxReplicas": { "type": "integer", "minimum": 2 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["groupName", "paths"],
      "properties": {
        "groupName": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string", "pattern": "^/" } }
      }
    }
  }
}
